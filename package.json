{
	"name": "akari",
	"description": "A (not-so) generic helper bot for Discord.",
	"version": "1.0.0",
	"author": {
		"name": "janleigh",
		"url": "https://github.com/janleigh/akari"
	},
	"license": "AGPL-3.0-only",
	"main": "src/index.ts",
	"scripts": {
		"start": "bun run start:prod",
		"dev": "bun run start:dev",
		"start:dev": "NODE_ENV=development bun run src/index.ts",
		"start:prod": "NODE_ENV=production bun run src/index.ts",
		"lint": "oxlint",
		"fmt": "oxfmt",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/bun": "1.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001"
	},
	"dependencies": {
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/framework": "^5.5.1",
		"@sapphire/pieces": "^4.4.1",
		"@sapphire/plugin-logger": "^4.1.0",
		"discord.js": "^14.27.0",
		"dotenv": "^17.2.3",
		"riffy": "^1.0.12"
	},
	"peerDependencies": {
		"typescript": "^5.9.3 || ^7.0.0"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts}": [
			"oxlint",
			"oxfmt"
		]
	}
}
