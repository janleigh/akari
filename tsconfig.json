{
	"compilerOptions": {
		"outDir": "dist/",
		"module": "esnext",
		"target": "esnext",

		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,

		"noEmit": true,
		"skipLibCheck": true,
		"experimentalDecorators": true,
		"allowSyntheticDefaultImports": true,

		"paths": {
			"@/*": ["./src/*"],
			"@lib/*": ["./src/lib/*"],
			"@utils/*": ["./src/lib/utils/*"]
		}
	},
	"exclude": [".git/", ".github/", ".vscode/", "build/"],
	"include": ["src/**/*", "scripts", "src/listeners/riffy"]
}
